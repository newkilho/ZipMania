{
  "name": "zipmania",
  "version": "0.1.0",
  "description": "ZipMania - Windows용 현대적 압축 프로그램 (Tauri + Svelte)",
  "type": "module",
  "scripts": {
    "dev": "npm run gen && vite",
    "skin": "vite build --config vite.skin-preview.config.js",
    "skin:serve": "vite --open /skin/default/index.html",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "gen": "cargo run -q -p zipmania-i18n --bin gen-strings",
    "check": "npm run gen && node scripts/check-refs.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "@tauri-apps/cli": "2.11.4",
    "svelte": "^4.2.12",
    "vite": "^5.2.0"
  }
}
