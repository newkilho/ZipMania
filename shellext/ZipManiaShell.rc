// ZipManiaShell.dll 버전 리소스.
//
// **이 파일이 DLL 버전의 유일한 출처다.** 설치 프로그램은 이 값을 어딘가에 옮겨 적어 두지
// 않고, 빌드된 DLL 에서 직접 읽는다(installer-hooks.nsh 의 !getdllversion). 그래서 여기만
// 고치면 된다.
//
// ── 버전 규칙: YYYY.M.D.R ──────────────────────────────────────────────────
//   YYYY  코드를 고친 해     (네 자리. 버전 필드는 16비트라 65535 까지 들어간다)
//   M     월  1~12           (앞에 0 을 붙이지 않는다 — 숫자 필드다)
//   D     일  1~31
//   R     같은 날 두 번 이상 고쳤을 때의 개정 번호. 0 부터.
//
//   이 DLL 은 탐색기 메뉴 구성만 하는 코드라 몇 달에 한 번 바뀔까 말까 한다. 그래서 빌드
//   시각을 자동으로 찍지 않고 **손으로 적는다** — 자동으로 찍으면 내용이 같아도 빌드할
//   때마다 버전이 올라가서, "같은 버전이면 건너뛴다"는 규칙 자체가 무의미해진다.
//
//   고친 날짜만 적으면 되고, 순서 비교도 문자열/숫자 어느 쪽으로도 자연스럽다.
//   (20260727 처럼 한 필드에 몰아넣는 방식은 못 쓴다 — 65535 를 넘는다.)
//
//   **코드를 고쳤으면 반드시 여기도 고친다.** 안 고치면 설치 프로그램이 "이미 같은 버전"
//   으로 보고 새 DLL 을 덮어쓰지 않는다.

#define ZMS_VER      2026,8,18,1
#define ZMS_VER_STR  "2026.8.18.1"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    ZMS_VER
  PRODUCTVERSION ZMS_VER
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_DLL
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041204B0"        // 한국어(0x0412) + 유니코드(1200)
    BEGIN
      VALUE "CompanyName",      "Kilhonet"
      VALUE "FileDescription",  "ZipMania Shell Extension"
      VALUE "FileVersion",      ZMS_VER_STR
      VALUE "InternalName",     "ZipManiaShell"
      VALUE "LegalCopyright",   "Copyright (C) 2026 Kilhonet"
      VALUE "OriginalFilename", "ZipManiaShell.dll"
      VALUE "ProductName",      "ZipMania"
      VALUE "ProductVersion",   ZMS_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0412, 1200
  END
END
